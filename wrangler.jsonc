{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Arts Sports storefront on Cloudflare Workers, built by OpenNext.
  // Until the custom domain is added this deploys to arts-sports.<subdomain>.workers.dev.
  "name": "arts-sports",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "arts-sports"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret runtime settings. Secrets (R2 keys, Supabase tokens) are set with
  // `npx wrangler secret put <NAME>`, never committed here.
  "vars": {
    "R2_BUCKET": "artssports-media"
  }
}
