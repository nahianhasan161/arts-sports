NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Object storage (Cloudflare R2) ---
# Product images are stored in a Cloudflare R2 bucket through its S3 API.
# Supabase remains the database and the auth provider.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token
# ("Object Read & Write", scoped to the bucket). The account id is on the
# R2 overview page. Locally these live in .env; on Cloudflare set them as
# Worker secrets:  npx wrangler secret put R2_ACCESS_KEY_ID   (etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=artssports-media

# Public base URL of the bucket. Leave empty to stream images through
# /api/media/<path> (private bucket). Before launch use the bucket's free
# r2.dev address (R2 -> bucket -> Settings -> Public Development URL); after
# launch use the custom domain, e.g. https://media.artssports.com
# Changing it also needs: node scripts/r2-set-media-prefix.mjs
R2_PUBLIC_URL=

# --- Tigris (current image storage, used until the R2 keys above are filled) ---
# The app uses R2 as soon as R2_ACCOUNT_ID, R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY are all set; until then it reads and writes Tigris.
# scripts/r2-migrate-from-tigris.mjs copies everything across when you switch.
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=artsfashion-media
# false: images stream through /api/media (bucket private, no payment method
# needed). true: served directly by Tigris (needs a verified payment method).
TIGRIS_STORAGE_PUBLIC=false

# --- Server-side database access (webhooks and jobs) ---
# Supabase -> Project Settings -> API keys -> service_role / secret key.
# Bypasses row level security: server only, never NEXT_PUBLIC_.
# On Cloudflare: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- UnivaPayment (online bKash / Nagad) ---
# Base URL of the UnivaPayment app, without /api. The API key decides test
# vs live mode. Webhook URL to enter in the UnivaPayment dashboard:
#   https://<site>/api/payments/webhooks/univapayment
# and add this site's domain to its allowed return-URL domains.
# On Cloudflare set the key and secret with `npx wrangler secret put`.
UNIVAPAYMENT_API_BASE=
UNIVAPAYMENT_API_KEY=
UNIVAPAYMENT_WEBHOOK_SECRET=
# Shows "bKash / Nagad (pay now)" at checkout instead of the manual
# transaction-ID fields. Turn on only after the three values above are set.
NEXT_PUBLIC_UNIVAPAYMENT_ENABLED=false

# --- Notifications ---
# Email through Resend (free tier). Leave empty to log emails as skipped.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
# The store's WhatsApp Business number (01XXXXXXXXX), for "message us" links.
NEXT_PUBLIC_STORE_WHATSAPP=

# ---------------------------------------------------------------
# Phase 1: selling from social media. Every block is optional:
# each feature switches on when its keys are set.
# ---------------------------------------------------------------

# Store WhatsApp (customers confirm orders and ask questions here) and the
# Facebook Page username for "Ask on Messenger".
NEXT_PUBLIC_STORE_WHATSAPP=
NEXT_PUBLIC_MESSENGER_PAGE=

# Google One Tap at checkout: the same Web client id as the Google provider
# in Supabase Auth (Authentication -> Providers -> Google).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (free bot check): dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta Pixel + Conversions API (Events Manager -> your pixel -> Settings).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Only while testing in Events Manager -> Test events.
META_CAPI_TEST_EVENT_CODE=

# GA4 measurement id (G-XXXXXXX). Leave empty if GA4 is set up inside GTM.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 -> Admin -> Data streams -> your stream -> Measurement Protocol API secrets.
# Sends paid orders from the server too (lib/tracking/server.ts).
GA4_API_SECRET=

# Google Tag Manager (GTM-XXXXXXX). A tag set up inside GTM must not also have
# its id in this file, or it counts twice. Shop events are pushed to
# dataLayer in GA4 ecommerce format with an event_id.
NEXT_PUBLIC_GTM_ID=
# Optional: a server-side GTM container on your own subdomain
# (e.g. https://sgtm.artssports.com); gtm.js then loads from there.
NEXT_PUBLIC_GTM_SERVER_URL=

# TikTok Pixel (Events Manager -> Web -> pixel id) and Events API token
# (same pixel -> Settings -> Events API -> Generate access token).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
# Only while testing in TikTok Events Manager -> Test events.
TIKTOK_TEST_EVENT_CODE=

# Pinterest Tag id (Ads -> Conversions -> Tag manager) and Conversions API:
# ad account id + a conversion token (Ads -> Conversions -> Conversions API).
NEXT_PUBLIC_PINTEREST_TAG_ID=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CAPI_TOKEN=
# "true" while testing (events are checked, not counted).
PINTEREST_CAPI_TEST=

# Site ownership tags (only the content="..." value of each).
# Google Search Console -> HTML tag; Bing Webmaster Tools -> meta tag;
# Pinterest -> Settings -> Claimed accounts; Meta Business -> Brand safety -> Domains.
GOOGLE_VERIFICATION_TOKEN=
YANDEX_VERIFICATION_TOKEN=
BING_VERIFICATION_TOKEN=
PINTEREST_DOMAIN_VERIFY=
FACEBOOK_DOMAIN_VERIFICATION=

# IndexNow: any 8-128 letters/digits/dashes you make up. Bing, Yandex (and
# through Bing, Copilot / ChatGPT search) hear about a saved product at once.
# The key is served at /indexnow.txt.
INDEXNOW_KEY=

# Anthropic API key (console.anthropic.com): the AI writes each product's
# search title, description, keywords and picture text after a save
# (lib/seo/ai-writer.ts). Without it the automatic text is used.
ANTHROPIC_API_KEY=

# Steadfast (merchant panel -> API). Webhook URL:
#   https://<site>/api/courier/webhooks/steadfast
# with "Auth token (Bearer)" set to STEADFAST_WEBHOOK_TOKEN.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=

# Pathao (merchant panel -> Developer API). Sandbox base:
#   https://courier-api-sandbox.pathao.com
# Webhook URL: https://<site>/api/courier/webhooks/pathao
PATHAO_API_BASE=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=
# The integration secret Pathao's webhook page shows, echoed back to verify the URL.
PATHAO_WEBHOOK_INTEGRATION_SECRET=

# Alpha preview only: show the made-up demo reviews (ids demo-*) on the storefront. Leave empty in production.
SHOW_DEMO_REVIEWS=
