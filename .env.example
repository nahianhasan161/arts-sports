NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Object storage (Cloudflare R2) ---
# Product images are stored in a Cloudflare R2 bucket through its S3 API.
# Supabase remains the database and the auth provider.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token
# ("Object Read & Write", scoped to the bucket). The account id is on the
# R2 overview page. Locally these live in .env; on Cloudflare set them as
# Worker secrets:  npx wrangler secret put R2_ACCESS_KEY_ID   (etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=artssports-media

# Public base URL of the bucket. Leave empty to stream images through
# /api/media/<path> (private bucket). Before launch use the bucket's free
# r2.dev address (R2 -> bucket -> Settings -> Public Development URL); after
# launch use the custom domain, e.g. https://media.artssports.com
# Changing it also needs: node scripts/r2-set-media-prefix.mjs
R2_PUBLIC_URL=

# --- Tigris (current image storage, used until the R2 keys above are filled) ---
# The app uses R2 as soon as R2_ACCOUNT_ID, R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY are all set; until then it reads and writes Tigris.
# scripts/r2-migrate-from-tigris.mjs copies everything across when you switch.
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=artsfashion-media
# false: images stream through /api/media (bucket private, no payment method
# needed). true: served directly by Tigris (needs a verified payment method).
TIGRIS_STORAGE_PUBLIC=false

# --- Server-side database access (webhooks and jobs) ---
# Supabase -> Project Settings -> API keys -> service_role / secret key.
# Bypasses row level security: server only, never NEXT_PUBLIC_.
# On Cloudflare: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- UnivaPayment (online bKash / Nagad) ---
# Base URL of the UnivaPayment app, without /api. The API key decides test
# vs live mode. Webhook URL to enter in the UnivaPayment dashboard:
#   https://<site>/api/payments/webhooks/univapayment
# and add this site's domain to its allowed return-URL domains.
# On Cloudflare set the key and secret with `npx wrangler secret put`.
UNIVAPAYMENT_API_BASE=
UNIVAPAYMENT_API_KEY=
UNIVAPAYMENT_WEBHOOK_SECRET=
# Shows "bKash / Nagad (pay now)" at checkout instead of the manual
# transaction-ID fields. Turn on only after the three values above are set.
NEXT_PUBLIC_UNIVAPAYMENT_ENABLED=false

# --- Notifications ---
# Email through Resend (free tier). Leave empty to log emails as skipped.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
# The store's WhatsApp Business number (01XXXXXXXXX), for "message us" links.
NEXT_PUBLIC_STORE_WHATSAPP=
